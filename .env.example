NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://music.example.com
TRUST_PROXY_HOPS=1

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=480
DATABASE_PATH=./data/open-music-club.sqlite
REDIS_URL=redis://127.0.0.1:6379

REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NICKNAME=管理员

ENABLE_GENERAL_UNBLOCK=false
# 独立于 Session Secret；生成后长期保管，丢失后无法解密已绑定的认证器。
# 生成命令：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

MAX_UPLOAD_MB=100

# 邮件是附加通知，默认关闭。SMTP 必须支持 TLS；465 使用隐式 TLS，其他端口强制 STARTTLS。
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=club@example.com
MAIL_ADMIN_TO=admin@example.com
