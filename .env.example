NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://music.example.com
# 仅开发环境使用，生产环境忽略；填写前端的完整 Origin，多个来源用逗号分隔。
# 例如 http://127.0.0.1:5173,http://localhost:5173,http://你的ZeroTier分配IP:5173
DEV_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=480
DATABASE_PATH=./data/open-music-club.sqlite
REDIS_URL=redis://127.0.0.1:6379

REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NICKNAME=管理员

ENABLE_GENERAL_UNBLOCK=false
# 独立于 Session Secret；生成后长期保管，丢失后无法解密已绑定的认证器。
# 生成命令：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

MAX_UPLOAD_MB=100

# 申请直接进入审核，通过后发送激活邮件；缺少邮件或加密配置时相关接口返回 503。
# 阿里云凭据只用于查询投递结果；查询不可用时保留未决状态，不作为审批门槛。
# SMTP 必须支持 TLS；465 使用隐式 TLS，其他端口强制 STARTTLS。
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=club@example.com
MAIL_ADMIN_TO=admin@example.com
# 独立的最小权限 RAM 凭据，仅授予 dm:SenderStatisticsDetailByParam；不是 SMTP 授权码。
# 只支持杭州区域，不使用主账号 AccessKey，不把真实值提交到 Git 或聊天。
ALIYUN_DM_REGION_ID=cn-hangzhou
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
# 使用临时 STS 凭据时填写；长期 RAM 凭据留空。
ALIYUN_DM_SECURITY_TOKEN=
# 激活邮件任务的独立 AES-256-GCM 密钥：32 字节标准 Base64，与 TOTP 密钥分开保管。
# 未配置时申请与审批返回 503；禁止提交真实值。
APPLICATION_MAIL_ENCRYPTION_KEY=
