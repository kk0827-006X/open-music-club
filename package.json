{
  "name": "open-music-club",
  "version": "0.1.0",
  "private": true,
  "description": "面向公网部署的音乐共享与播放服务",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently --kill-others --names api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "pnpm --dir frontend dev",
    "build:web": "pnpm --dir frontend build",
    "db:init": "node src/db/init.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:coverage": "c8 --include='src/**' --exclude='vendor/**' --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "workspace:*",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "connect-redis": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "music-metadata": "^11.15.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2"
  }
}
