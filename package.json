{
  "name": "open-music-club",
  "version": "0.1.0",
  "private": true,
  "description": "局域网音乐共享与播放服务",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:coverage": "c8 --include='src/**' --exclude='vendor/**' --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "workspace:*",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "connect-sqlite3": "^0.9.18",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "node-gyp": "^13.0.2",
    "supertest": "^7.2.2"
  }
}
